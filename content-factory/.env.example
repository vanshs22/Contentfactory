# LLM (required to run the agent pipeline)
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
DIRECTOR_MODEL=gpt-4o
RESEARCH_MODEL=gpt-4o-mini
SCRIPT_MODEL=gpt-4o
VISUAL_MODEL=gpt-4o
QC_MODEL=gpt-4o

# Buffer GraphQL publishing (optional; drafts are used by default)
BUFFER_API_KEY=
BUFFER_ORG_ID=

# Storage and externally fetchable media URL
STORAGE_ROOT=./storage
PUBLIC_BASE_URL=http://localhost:3100/assets

# Server
PORT=3100
CORS_ORIGIN=http://localhost:3100
NODE_ENV=development
LOG_LEVEL=info

# HyperFrames and media validation
HYPERFRAMES_BIN=npx hyperframes
RENDER_FPS=30
RENDER_QUALITY=standard

# Quality gate
QC_MIN_SCORE=85
MAX_REVISIONS=2

# Reserved for a future distributed queue
REDIS_URL=
